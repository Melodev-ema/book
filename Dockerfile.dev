# Image de développement (docker-compose.yml) : le code est monté en volume, serveur de dev Astro
FROM node:22-alpine

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    PUPPETEER_SKIP_DOWNLOAD=1

WORKDIR /app

# Chromium (PDF) et Pandoc (import de fichiers)
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ttf-freefont \
    libstdc++ \
    gcompat \
    ca-certificates \
    pandoc-cli

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 3000

CMD ["npm", "run", "dev"]
