---
import BaseLayout from './BaseLayout.astro';

// Pages légales : même univers que la page d'accueil, sans JavaScript
interface Props {
    title: string;
    bookTitle: string;
}

const {title, bookTitle} = Astro.props;
---
<BaseLayout title={`${title} — ${bookTitle}`}>
    <div class="min-h-screen bg-atelier-ground font-instrument text-atelier-ink antialiased">
        <header class="border-b border-atelier-line bg-atelier-panel">
            <div class="mx-auto flex h-16 max-w-3xl items-center px-5 sm:px-8">
                <a href="/" class="font-fraunces text-lg font-medium italic hover:text-lilas-light">← {bookTitle}</a>
            </div>
        </header>
        <main class="mx-auto max-w-3xl px-5 py-16 sm:px-8 [&_a]:text-lilas [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:font-fraunces [&_h2]:text-2xl [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-atelier-ink [&_li]:leading-relaxed [&_li]:text-atelier-muted [&_p]:leading-relaxed [&_p]:text-atelier-muted [&_p+p]:mt-3 [&_strong]:font-semibold [&_strong]:text-atelier-ink [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-2">
            <h1 class="font-fraunces text-4xl font-normal tracking-tight sm:text-5xl">{title}</h1>
            <slot/>
        </main>
        <footer class="border-t border-atelier-line">
            <nav aria-label="Informations légales" class="mx-auto flex max-w-3xl gap-6 px-5 py-10 text-sm text-atelier-subtle sm:px-8">
                <a href="/mentions-legales" class="hover:text-atelier-ink">Mentions légales</a>
                <a href="/confidentialite" class="hover:text-atelier-ink">Politique de confidentialité</a>
            </nav>
        </footer>
    </div>
</BaseLayout>
