---
import Toaster from '../components/Toaster.vue';
import '~/assets/styles/fonts.scss';
import '~/assets/styles/tailwind.css';
import '~/assets/styles/main.css';
import '~/assets/styles/pageSize.scss';

interface Props {
    title?: string;
    description?: string;
    lang?: string;
    bodyClass?: string;
    theme?: string;
}

const {title, description, lang = 'fr', bodyClass, theme} = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    {title && <title>{title}</title>}
    {description && <meta name="description" content={description}/>}
    <meta name="theme-color" content="#1C1F2B"/>
    <link rel="icon" href="/favicon.ico" sizes="48x48"/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href="/site.webmanifest"/>
    <link rel="preconnect" href="https://cdn.fontshare.com"/>
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@800,500,700&display=swap"/>
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@800,500,700&display=swap"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Instrument+Sans:wght@400..600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"/>
    <slot name="head"/>
</head>
<body class={bodyClass} data-theme={theme}>
    <slot/>
    <Toaster position="top-right" client:load/>
</body>
</html>
