---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Erreur interne du serveur">
    <div class="flex flex-col items-center justify-center min-h-screen p-4 no-print">
        <h1 class="text-4xl font-bold mb-2">Erreur interne du serveur</h1>
        <p class="mb-4">Une erreur est survenue.</p>
        <a href="/" class="px-4 py-2 rounded bg-cyan-600 text-white hover:bg-cyan-700">
            Retour à l’accueil
        </a>
    </div>
</BaseLayout>
