---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookPage from '../../components/poems/BookPage.vue';

// L'accès (session ou jeton) est vérifié par le middleware
const token = Astro.url.searchParams.get('token') || '';
const excerpt = Boolean(Astro.url.searchParams.get('extrait'));
---
<BaseLayout title="Livre" theme="dark">
    <BookPage token={token} excerpt={excerpt} client:only="vue"/>
</BaseLayout>
